    "classes": {
      "title": "Academic Classes",
      "description": "Top-level metadata for academic tiers (Class 9, Class 10, Class 11, Class 12). keeps classes strictly isolated.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier e.g. class-9, class-10, class-11, class-12" },
        "name": { "type": "string", "description": "Display name of the class e.g. Class 10" },
        "hindiName": { "type": "string", "description": "Hindi title e.g. कक्षा 10वीं" },
        "gradeNumber": { "type": "number", "description": "Numeric grade (9, 10, 11, 12)" },
        "description": { "type": "string", "description": "Academic tier overview and board alignment" }
      },
      "required": ["id", "name", "gradeNumber"]
    },
    "subjects": {
      "title": "Subjects",
      "description": "Academic subjects strictly partitioned by classLevel.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Subject identifier e.g. c10-math" },
        "classLevel": { "type": "string", "description": "Class identifier: class-9, class-10, class-11, or class-12" },
        "name": { "type": "string", "description": "English name of the subject" },
        "hindiName": { "type": "string", "description": "Hindi script representation of the subject" },
        "code": { "type": "string", "description": "Board subject code" },
        "stream": { "type": "string", "description": "Academic stream e.g. General, Science, Arts, Commerce" },
        "description": { "type": "string", "description": "Syllabus overview and exam weightage" }
      },
      "required": ["id", "classLevel", "name"]
    },
    "books": {
      "title": "Textbooks",
      "description": "Official and reference textbooks mapped to a specific subject and class.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Book ID" },
        "subjectId": { "type": "string", "description": "Foreign key to subject" },
        "classLevel": { "type": "string", "description": "Class level constraint" },
        "title": { "type": "string", "description": "Textbook title" },
        "hindiTitle": { "type": "string", "description": "Textbook Hindi title" },
